[Unit]
Description=Hermes Gateway (Buzz platform — native gateway integration)
After=network-online.target buzz-relay.service
Wants=network-online.target

[Service]
Type=simple
User=<USER>
Group=<GROUP>
Environment=HERMES_HOME=/home/<USER>/.hermes/profiles/<PROFILE>
WorkingDirectory=<BUZZ_CHECKOUT_DIR>
ExecStart=<HERMES_VENV>/bin/python -m hermes_cli.main -p <PROFILE> gateway run
Restart=on-failure
RestartSec=15
TimeoutStopSec=30

# --- Hardening --------------------------------------------------------------
# ProtectSystem=full read-only-mounts the OS dirs (/usr, /boot, /etc) for this
# process, which is what stops a prompt-injected gateway from tampering with the
# system. We keep ProtectHome writable ON PURPOSE:
#
#   The Hermes gateway MUST write shared state OUTSIDE the profile dir — identity
#   locks under ~/.local/state/hermes, kanban state/locks under ~/.hermes/kanban* —
#   so ProtectHome=read-only / ProtectSystem=strict break startup (Errno 30
#   read-only on those lock files). Avoid telling users those flags will just
#   work.
#
# If you want the stricter variant, you must whitelist every real writable path:
#
#   ProtectSystem=strict
#   ProtectHome=read-only
#   ReadWritePaths=/home/<USER>/.hermes/profiles/<PROFILE> \
#                  /home/<USER>/.local/state/hermes \
#                  /home/<USER>/.hermes/kanban \
#                  /home/<USER>/.hermes/kanban.db \
#                  /media/<MOUNT>/LLMs        # downloader agents only
#
# ...and re-verify after every Hermes upgrade (the shared-state set can grow).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
UMask=0077

[Install]
WantedBy=multi-user.target
