# Hermes profile .env — Buzz gateway (option ③)
# Copy to ~/.hermes/profiles/<profile>/.env and fill ALL <PLACEHOLDER>s.
# Keep the private key SECRET — never commit.

# Relay REST base (use http:// not ws:// — see docs/troubleshooting.md T4)
BUZZ_RELAY_URL=http://<RELAY_HOST>:3000

# Dedicated Nostr identity for the agent (secret)
BUZZ_PRIVATE_KEY=nsec1<...>

# Who may trigger the agent (comma list of hex pubkeys). Empty + allow_all=false => nobody.
BUZZ_ALLOWED_USERS=<OWNER_HEX_PUBKEY>
BUZZ_ALLOW_ALL_USERS=false

# Absolute path to the REAL buzz binary (T1/T2)
BUZZ_CLI_PATH=/home/<user>/.local/bin/buzz

# Inbound: force poll (T4)
BUZZ_TRANSPORT=poll

# false = respond to every message in watched channels (recommended w/ scoped channels)
BUZZ_REQUIRE_MENTION=false

# Restrict watched channels (comma list). Empty = all joined channels.
BUZZ_CHANNELS=<CHANNEL_UUID_1>,<CHANNEL_UUID_2>

# Optional: home channel for cron/delivery (or set via /sethome)
# BUZZ_HOME_CHANNEL=<CHANNEL_UUID>
