# Hermes profile .env — Buzz gateway (option ③)
# Copy to ~/.hermes/profiles/<profile>/.env, fill ALL <PLACEHOLDER>s, then:
#   chmod 600 ~/.hermes/profiles/<profile>/.env
# ⚠️ This file contains your agent's private key. NEVER commit it (it is in
#    .gitignore), never paste it into a command line / argv, never log it.

# Relay REST base (use http:// for localhost; https:// behind TLS for remote)
BUZZ_RELAY_URL=http://<RELAY_HOST>:3000

# Dedicated Nostr identity for the agent (secret)
BUZZ_PRIVATE_KEY=nsec1<...>

# Who may trigger the agent (comma list of HEX pubkeys, not names).
# Empty + allow_all=false => nobody. This gates dispatch.
BUZZ_ALLOWED_USERS=<OWNER_HEX_PUBKEY>
BUZZ_ALLOW_ALL_USERS=false

# Absolute path to the REAL buzz binary (T1/T2/T13)
# Point at the actual binary, NOT a ~/.local/bin symlink (a desktop build
# overwrites symlinks with a 0-byte stub that breaks every gateway).
BUZZ_CLI_PATH=<BUZZ_REPO>/target/debug/buzz

# Inbound: force poll (T4)
BUZZ_TRANSPORT=poll

# false = respond to every message in watched channels (recommended ONLY with
#         scoped channels + strict BUZZ_ALLOWED_USERS — see config-reference)
BUZZ_REQUIRE_MENTION=false

# Restrict watched channels (comma list of channel UUIDs). Empty = all joined.
BUZZ_CHANNELS=<CHANNEL_UUID_1>,<CHANNEL_UUID_2>

# Optional: home channel for cron/delivery (or set via /sethome)
# BUZZ_HOME_CHANNEL=<CHANNEL_UUID>
